###############################################################################
# The Smarter Project environment variables.
#
# `make` copies this file to '.env' in the root of the project the first time
# you run it, and adds a new SMARTER_FERNET_ENCRYPTION_KEY. That is all you need
# to run the platform locally with Docker: `make init`, then `make run`.
#
# Everything else is optional. A feature whose setting is missing still lets
# the platform run: it logs a console error that says what to set, and where
# to get it, when the feature is used. For example, without an LLM provider's
# API key, the built-in LLMClients answer with an error that names the key.
#
# Do NOT commit the .env file to version control! .gitignore is preconfigured
# to ignore it, as well as other sensitive files.
#
# How the values are read:
#   - Smarter settings may be written with or without the SMARTER_ prefix.
#     ROOT_DOMAIN and SMARTER_ROOT_DOMAIN are the same setting, and the
#     unprefixed name wins when both are set. SMARTER_ROOT_DOMAIN becomes
#     smarter_settings.root_domain in smarter/common/conf/settings.py.
#   - A placeholder that begins with SET-ME, such as SET-ME-PLEASE, is unset.
#   - Lists are comma-separated: SMARTER_ALLOWED_HOSTS=a.example.com,b.example.com
#   - Variables prefixed with DJANGO_ override the Django setting of the same
#     name, without the prefix. See the bottom of smarter/settings/base.py.
#   - Variables set in the actual environment (your shell, CI/CD) override the
#     values in this file. Docker Compose, the Makefile and python-dotenv all
#     read it.
#
# NOTE: for local development it might be necessary to run `source .env` so that
# your shell and your IDE pick up these variables. If you are using VS Code, you
# may need to restart it after sourcing .env so that PYTHONPATH is picked up.
###############################################################################


###############################################################################
#                                                                             #
#                                1. REQUIRED                                  #
#                                                                             #
###############################################################################

#------------------------------------------------------------------------------
# SMARTER_FERNET_ENCRYPTION_KEY (REQUIRED) -> smarter_settings.fernet_encryption_key
# Encrypts Smarter Secrets, such as API keys, in the database.
# Note that `make` creates and adds a key value to .env when it creates the file.
#
# To create one yourself:
#
#   openssl rand -base64 32 | tr '+/' '-_'
#
# Without it, every process (smarter-app, each worker, each manage.py call)
# generates its own random key, so a Secret that one process encrypts cannot be
# decrypted by another, and every Secret becomes unreadable after a restart.
#------------------------------------------------------------------------------
# SMARTER_FERNET_ENCRYPTION_KEY=SET-ME-PLEASE


###############################################################################
#                                                                             #
#                          2. LOCAL DEVELOPMENT                               #
#                                                                             #
# Read by Docker Compose, the Makefile, your IDE and npm. The values here     #
# suit local development.                                                     #
###############################################################################

#------------------------------------------------------------------------------
# DOCKER_COLLECT_STATIC_FILES
# Passed by docker-compose.yml to the Dockerfile as a build argument, where it
# controls whether collectstatic runs during the build.
#------------------------------------------------------------------------------
DOCKER_COLLECT_STATIC_FILES=true

#------------------------------------------------------------------------------
# PYTHONPATH
# Lets pylint, flake8 and Cornflakes find the smarter module when run from
# inside VS Code. The Dockerfile sets PYTHONPATH for the containers.
#------------------------------------------------------------------------------
PYTHONPATH=./venv:./smarter

#------------------------------------------------------------------------------
# ENV_LOADED
# Confirms that this file was loaded. The containers have no .env file of their
# own, so without it they print a ".env file was NOT loaded" warning.
#------------------------------------------------------------------------------
ENV_LOADED=true

#------------------------------------------------------------------------------
# NODE_ENV
# Node environment for React development. `make react-build` sets
# NODE_ENV=production itself.
#------------------------------------------------------------------------------
NODE_ENV=development

#------------------------------------------------------------------------------
# ENVIRONMENT -> smarter_settings.environment
# One of: local, alpha, beta, next, prod. Default: local.
#------------------------------------------------------------------------------
ENVIRONMENT=local

#------------------------------------------------------------------------------
# DEBUG_MODE -> smarter_settings.debug_mode
# Sets the log level to DEBUG and determines how static files are served.
# Default: false.
#------------------------------------------------------------------------------
DEBUG_MODE=true

#------------------------------------------------------------------------------
# SMARTER_DEVELOPER_MODE -> smarter_settings.developer_mode
# Enables local-only tools, such as the Django Debug Toolbar and Django
# Extensions. Default: false.
#------------------------------------------------------------------------------
# SMARTER_DEVELOPER_MODE=true

#------------------------------------------------------------------------------
# SMARTER_SETTINGS_OUTPUT -> smarter_settings.settings_output
# Prints each smarter_settings value that an environment variable overrides,
# during startup and management commands. Default: false.
#------------------------------------------------------------------------------
SMARTER_SETTINGS_OUTPUT=true

#------------------------------------------------------------------------------
# GH_TOKEN (aka PAT)
# GitHub Personal Access Token. Only needed to contribute to the Smarter project
# on GitHub.
#------------------------------------------------------------------------------
# GH_TOKEN=SET-ME-PLEASE
GITHUB_TOKEN=$GH_TOKEN


###############################################################################
#                                                                             #
#                    3. OPTIONAL: LLM PROVIDERS AND TOOLS                     #
#                                                                             #
# Not Settings fields: `python manage.py initialize_providers`, which         #
# `make init` runs, stores each key as a Smarter Secret. Every built-in       #
# Provider is created with or without its key. Prompts to a Provider without  #
# a key fail with an error that names the key to set. After adding a key,     #
# restart the platform and run:                                               #
#                                                                             #
#   docker exec smarter-app python manage.py initialize_providers             #
###############################################################################

#------------------------------------------------------------------------------
# SMARTER_OPENAI_API_KEY (STRONGLY RECOMMENDED)
# OpenAI is the platform's default LLM provider, used by most of the built-in
# LLMClients. Set this key first.
# see: https://platform.openai.com/api-keys
#------------------------------------------------------------------------------
# SMARTER_OPENAI_API_KEY=SET-ME-PLEASE

#------------------------------------------------------------------------------
# Other LLM providers.
#
# SMARTER_ANTHROPIC_API_KEY    https://console.anthropic.com/settings/keys
# SMARTER_COHERE_API_KEY       https://dashboard.cohere.com/api-keys
# SMARTER_FIREWORKS_API_KEY    https://fireworks.ai/api-keys/
# SMARTER_GEMINI_API_KEY       https://aistudio.google.com/app/apikey
# SMARTER_LLAMA_API_KEY        https://llama.developer.meta.com/
# SMARTER_MISTRAL_API_KEY      https://console.mistral.ai/api-keys/
# SMARTER_TOGETHERAI_API_KEY   https://together.ai/settings/api-keys
#------------------------------------------------------------------------------
# SMARTER_ANTHROPIC_API_KEY=SET-ME-PLEASE
# SMARTER_COHERE_API_KEY=SET-ME-PLEASE
# SMARTER_FIREWORKS_API_KEY=SET-ME-PLEASE
# SMARTER_GEMINI_API_KEY=SET-ME-PLEASE
# SMARTER_LLAMA_API_KEY=SET-ME-PLEASE
# SMARTER_MISTRAL_API_KEY=SET-ME-PLEASE
# SMARTER_TOGETHERAI_API_KEY=SET-ME-PLEASE

#------------------------------------------------------------------------------
# SMARTER_TAVILY_API_KEY (RECOMMENDED)
# Tavily web search, used by the built-in WebsearchPlugin smarter_project_websearch,
# which the built-in smarter LLMClient uses. Stored as the Secret tavily_api_key.
# see: https://tavily.com
#------------------------------------------------------------------------------
# SMARTER_TAVILY_API_KEY=SET-ME-PLEASE

#------------------------------------------------------------------------------
# SMARTER_GOOGLE_MAPS_API_KEY (RECOMMENDED)
# Google Maps, used by the get_current_weather() example function to find a
# location. Stored as the Secret google_maps_api_key.
# see: https://developers.google.com/maps/documentation/geocoding/get-api-key
#------------------------------------------------------------------------------
# SMARTER_GOOGLE_MAPS_API_KEY=SET-ME-PLEASE

#------------------------------------------------------------------------------
# SMARTER_GOOGLE_SERVICE_ACCOUNT_B64
# A base64-encoded Google Cloud service account JSON credential, from which
# Google Cloud bearer tokens are obtained. Stored as the Secret google_service_account.
# See ./scripts/google-service-account.sh for how to encode the credential.
# see: https://console.cloud.google.com/iam-admin/serviceaccounts
#------------------------------------------------------------------------------
# SMARTER_GOOGLE_SERVICE_ACCOUNT_B64=SET-ME-PLEASE

#------------------------------------------------------------------------------
# SMARTER_PINECONE_API_KEY and SMARTER_PINECONE_ENVIRONMENT
# Pinecone vector database, stored by `manage.py initialize_vectorstore_providers`.
# see: https://docs.pinecone.io/docs/get-started
#------------------------------------------------------------------------------
# SMARTER_PINECONE_API_KEY=SET-ME-PLEASE
# SMARTER_PINECONE_ENVIRONMENT=SET-ME-PLEASE


###############################################################################
#                                                                             #
#                      4. OPTIONAL: CLOUD DEPLOYMENT                          #
#                                                                             #
# Needed to deploy LLMClients to production Kubernetes, with their DNS        #
# records and TLS certificates. Without them, the platform runs, and the      #
# deployments that need them are skipped with a console warning.              #
###############################################################################

#------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_REGION
#   -> smarter_settings.aws_access_key_id
#   -> smarter_settings.aws_secret_access_key
#   -> smarter_settings.aws_region
# AWS credentials, or AWS_PROFILE instead of the keypair. They are used for
# Route53 DNS, ACM certificates, the EKS cluster, S3 file storage and AWS SES
# email. Without them, Django file storage falls back to the local file system.
# They must have permission to manage the AWS resources used by the platform,
# including but not limited to ECR, EC2, EKS, RDS, S3, Route53, SES and IAM.
#------------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=SET-ME-PLEASE
# AWS_SECRET_ACCESS_KEY=SET-ME-PLEASE
# AWS_PROFILE=default

#------------------------------------------------------------------------------
# SMARTER_AWS_EKS_CLUSTER_NAME -> smarter_settings.aws_eks_cluster_name
# The EKS cluster to which LLMClients and LLMHosts are deployed. Without it,
# nothing is deployed to Kubernetes.
#------------------------------------------------------------------------------
# SMARTER_AWS_EKS_CLUSTER_NAME=SET-ME-PLEASE

#------------------------------------------------------------------------------
# SMARTER_LLMHOST_NODE_ROLE_ARN and SMARTER_LLMHOST_NODE_SUBNET_IDS
#   -> smarter_settings.llmhost_node_role_arn
#   -> smarter_settings.llmhost_node_subnet_ids
# The IAM role and the comma-separated subnets of the EKS node groups that
# llmhost creates. Both default to those of the cluster's existing node group.
#------------------------------------------------------------------------------
# SMARTER_LLMHOST_NODE_ROLE_ARN=
# SMARTER_LLMHOST_NODE_SUBNET_IDS=

#------------------------------------------------------------------------------
# SMARTER_ROOT_DOMAIN -> smarter_settings.root_domain
# The root domain of your deployment. Every platform, API and LLMClient domain,
# and the Kubernetes namespace, are derived from it. Default: example.com,
# which is fine locally, where the platform is served from localhost.
#
# An AWS Route53 Hosted Zone for this domain must exist before LLMClients that
# use it are deployed, and the AWS credentials must be able to manage its records.
#------------------------------------------------------------------------------
# SMARTER_ROOT_DOMAIN=example.com

#------------------------------------------------------------------------------
# SMARTER_PLATFORM_SUBDOMAIN -> smarter_settings.platform_subdomain
# The subdomain of SMARTER_ROOT_DOMAIN that hosts the platform. Default: platform
#------------------------------------------------------------------------------
# SMARTER_PLATFORM_SUBDOMAIN=platform

#------------------------------------------------------------------------------
# SMARTER_CLOUD_PROVIDER -> smarter_settings.cloud_provider
# The cloud of the platform's DNS, TLS certificates and Kubernetes credentials.
# See smarter.apps.infrastructure. Default: aws. Use memory to keep them in
# memory, for local development without a cloud account.
#------------------------------------------------------------------------------
# SMARTER_CLOUD_PROVIDER=aws

#------------------------------------------------------------------------------
# SMARTER_SECRET_KEY -> smarter_settings.secret_key -> Django SECRET_KEY
# Django secret key, for session signing and password reset tokens: a long
# (50+ characters), random string. DJANGO_SECRET_KEY also works. If unset, a
# random key is generated at startup, so every restart signs out all users:
# fine locally, but set it for any deployment that real users reach.
#------------------------------------------------------------------------------
# SMARTER_SECRET_KEY=SET-ME-PLEASE


###############################################################################
#                                                                             #
#                            5. OPTIONAL: EMAIL                               #
#                                                                             #
# Without SMTP credentials, email is not sent, and each email that is not     #
# sent logs a console error with these instructions.                          #
###############################################################################

#------------------------------------------------------------------------------
# SMARTER_SMTP_USERNAME and SMARTER_SMTP_PASSWORD
#   -> smarter_settings.smtp_username
#   -> smarter_settings.smtp_password
# Your SMTP server's credentials. With AWS SES, create them in the SES console:
# https://docs.aws.amazon.com/ses/latest/dg/smtp-credentials.html
#------------------------------------------------------------------------------
# SMARTER_SMTP_USERNAME=SET-ME-PLEASE
# SMARTER_SMTP_PASSWORD=SET-ME-PLEASE

#------------------------------------------------------------------------------
# SMARTER_SMTP_HOST and SMARTER_SMTP_PORT
#   -> smarter_settings.smtp_host
#   -> smarter_settings.smtp_port
# Your SMTP server. Default host: the AWS SES endpoint of AWS_REGION,
# email-smtp.<AWS_REGION>.amazonaws.com. Default port: 587.
#------------------------------------------------------------------------------
# SMARTER_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMARTER_SMTP_PORT=587

#------------------------------------------------------------------------------
# SMARTER_SMTP_FROM_EMAIL -> smarter_settings.smtp_from_email
# The From address of outgoing email.
# Default: no-reply@<SMARTER_PLATFORM_SUBDOMAIN>.<SMARTER_ROOT_DOMAIN>
#------------------------------------------------------------------------------
# SMARTER_SMTP_FROM_EMAIL=no-reply@platform.example.com

#------------------------------------------------------------------------------
# SMARTER_SMTP_SENDER -> smarter_settings.smtp_sender
# SMTP email sender. Default: admin@<SMARTER_ROOT_DOMAIN>
#------------------------------------------------------------------------------
# SMARTER_SMTP_SENDER=admin@example.com

#------------------------------------------------------------------------------
# SMARTER_EMAIL_ADMIN -> smarter_settings.email_admin
# The platform administrator, who receives a blind copy of platform emails.
# Default: admin@example.com
#------------------------------------------------------------------------------
# SMARTER_EMAIL_ADMIN=admin@example.com

#------------------------------------------------------------------------------
# SMARTER_MAILCHIMP_API_KEY and SMARTER_MAILCHIMP_LIST_ID
#  -> smarter_settings.mailchimp_api_key
#  -> smarter_settings.mailchimp_list_id
# Mailchimp marketing email integration.
# see: https://mailchimp.com/developer/marketing/guides/quick-start/
#------------------------------------------------------------------------------
# SMARTER_MAILCHIMP_API_KEY=SET-ME-PLEASE
# SMARTER_MAILCHIMP_LIST_ID=SET-ME-PLEASE


###############################################################################
#                                                                             #
#                          6. OPTIONAL: EVERYTHING ELSE                       #
#                                                                             #
# The defaults suit most installations.                                       #
###############################################################################

###############################################################################
# Authentication
###############################################################################

#------------------------------------------------------------------------------
# SMARTER_SOCIAL_AUTH_GOOGLE_OAUTH2_KEY and SMARTER_SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET
#   -> smarter_settings.social_auth_google_oauth2_key
#   -> smarter_settings.social_auth_google_oauth2_secret
# Google OAuth2 credentials for social authentication.
# see: https://console.developers.google.com/apis/credentials
#------------------------------------------------------------------------------
# SMARTER_SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=SET-ME-PLEASE
# SMARTER_SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=SET-ME-PLEASE

#------------------------------------------------------------------------------
# SMARTER_SOCIAL_AUTH_GITHUB_KEY and SMARTER_SOCIAL_AUTH_GITHUB_SECRET
#   -> smarter_settings.social_auth_github_key
#   -> smarter_settings.social_auth_github_secret
# GitHub OAuth2 credentials for social authentication.
# see: https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
#------------------------------------------------------------------------------
# SMARTER_SOCIAL_AUTH_GITHUB_KEY=SET-ME-PLEASE
# SMARTER_SOCIAL_AUTH_GITHUB_SECRET=SET-ME-PLEASE

#------------------------------------------------------------------------------
# DJANGO_AUTHENTICATION_BACKENDS
# Comma-separated list of Django authentication backends, tried in order.
#
# Possible values:
# - social_core.backends.github.GithubOAuth2
# - social_core.backends.google.GoogleOAuth2
# - django.contrib.auth.backends.ModelBackend
# - smarter.lib.social_core.backends.multitenant.GoogleOAuth2Multitenant
# - smarter.lib.social_core.backends.multitenant.GithubOAuth2Multitenant
# - smarter.lib.social_core.backends.multitenant.DjangoModelBackendMultitenant
#
# The default includes Google OAuth2, GitHub OAuth2 and the Django ModelBackend,
# each with multitenant support. If oauth backends are used and their keys above
# are set, the login page displays a social login button for each one.
#------------------------------------------------------------------------------
# DJANGO_AUTHENTICATION_BACKENDS=smarter.lib.social_core.backends.multitenant.GoogleOAuth2Multitenant,smarter.lib.social_core.backends.multitenant.GithubOAuth2Multitenant,smarter.lib.social_core.backends.multitenant.DjangoModelBackendMultitenant

#------------------------------------------------------------------------------
# DJANGO_ADMINS
# List of tuples of name and email address of the Django admins, to whom Django
# sends error notifications.
# see: https://docs.djangoproject.com/en/6.0/ref/settings/#admins
#------------------------------------------------------------------------------
# DJANGO_ADMINS=[("Your Name", "your_email@example.com"),("Another Admin", "another_admin@example.com"),]

###############################################################################
# Feature flags. All default to true.
###############################################################################

# SMARTER_ENABLE_DASHBOARD_SERVER_LOGS=true    # the dashboard server logs
# SMARTER_ENABLE_VECTORSTORE=true              # vectorstores
# SMARTER_ENABLE_PROXY=true                    # Proxies
# SMARTER_ENABLE_MANIFEST_DROPZONE=true        # the dashboard manifest apply dropzone
# SMARTER_FILE_DROP_ZONE_ENABLED=true          # drag and drop of manifest files into the web console

###############################################################################
# Branding
###############################################################################

#------------------------------------------------------------------------------
# SMARTER_MARKETING_SITE_URL -> smarter_settings.marketing_site_url
# The public marketing URL of your deployment, used in web and email templates.
# Default: https://<SMARTER_ROOT_DOMAIN>
#------------------------------------------------------------------------------
# SMARTER_MARKETING_SITE_URL="https://example.com"

#------------------------------------------------------------------------------
# SMARTER_LOGO -> smarter_settings.logo
# URL of the logo image used in the Smarter web console.
#------------------------------------------------------------------------------
# SMARTER_LOGO="https://example.com/logo.png"

#------------------------------------------------------------------------------
# SMARTER_BRANDING_* -> smarter_settings.branding_*
# Identity shown in the web console, e.g. in the common footer.
#------------------------------------------------------------------------------
# SMARTER_BRANDING_CORPORATE_NAME="The Smarter Project"
# SMARTER_BRANDING_SUPPORT_PHONE_NUMBER="+1 (555) 123-4567"
# SMARTER_BRANDING_SUPPORT_EMAIL="support@example.com"
# SMARTER_BRANDING_ADDRESS1="1234 Smarter St, Smarter City, SM 12345"
# SMARTER_BRANDING_ADDRESS2="Suite 100"
# SMARTER_BRANDING_CITY="Smarter City"
# SMARTER_BRANDING_STATE="SM"
# SMARTER_BRANDING_POSTAL_CODE="12345"
# SMARTER_BRANDING_COUNTRY="Smarterland"
# SMARTER_BRANDING_TIMEZONE="America/Denver"
# SMARTER_BRANDING_CURRENCY="USD"
# SMARTER_BRANDING_CONTACT_URL="http://example.com/contact-us"
# SMARTER_BRANDING_SUPPORT_HOURS="MON-FRI 9:00 AM - 5:00 PM GMT-6 (CST)"
# SMARTER_BRANDING_URL_FACEBOOK="https://www.facebook.com/example"
# SMARTER_BRANDING_URL_TWITTER="https://twitter.com/example"
# SMARTER_BRANDING_URL_LINKEDIN="https://www.linkedin.com/company/example"

###############################################################################
# API and networking
###############################################################################

# SMARTER_API_SCHEMA="https"                   # ignored locally, which always uses http. Default: http
# SMARTER_API_NAME="Smarter API"               # used in the API documentation and OpenAPI schema
# SMARTER_API_DESCRIPTION="A declarative AI resource management platform and developer framework"

#------------------------------------------------------------------------------
# SMARTER_ALLOWED_HOSTS -> smarter_settings.allowed_hosts
# Comma-separated host names that are allowed in addition to the platform and
# API domains. Default: localhost,testserver
#------------------------------------------------------------------------------
# SMARTER_ALLOWED_HOSTS=localhost,testserver

#------------------------------------------------------------------------------
# SMARTER_INTERNAL_IP_PREFIXES -> smarter_settings.internal_ip_prefixes
# Comma-separated internal IP prefixes, which identify Kubernetes readiness,
# liveness and health check probes as internal requests that are exempted from
# certain security checks. Default: 192.168.
#------------------------------------------------------------------------------
# SMARTER_INTERNAL_IP_PREFIXES=192.168.

###############################################################################
# Chat, LLMClient, plugin and Celery tuning
###############################################################################

# SMARTER_CHAT_CACHE_EXPIRATION=300                    # seconds, for chat message views
# SMARTER_LLM_CLIENT_CACHE_EXPIRATION=300              # seconds. Not currently in use
# SMARTER_LLM_CLIENT_MAX_RETURNED_HISTORY=25           # Not currently in use
# SMARTER_LLM_CLIENT_TASKS_CREATE_DNS_RECORD=true      # a DNS record per LLMClient, unless the API domain has a wildcard A record
# SMARTER_LLM_CLIENT_TASKS_CREATE_INGRESS_MANIFEST=true # a Kubernetes ingress and TLS certificate per LLMClient
# SMARTER_LLM_CLIENT_TASKS_DEFAULT_TTL=600             # seconds, of the LLMClients' DNS records
# SMARTER_LLM_CLIENT_TASKS_CELERY_MAX_RETRIES=3
# SMARTER_LLM_CLIENT_TASKS_CELERY_RETRY_BACKOFF=true
# SMARTER_LLM_CLIENT_TASKS_CELERY_TASK_QUEUE="default_celery_task_queue"
# SMARTER_PLUGIN_MAX_DATA_RESULTS=50                   # rows that any plugin can return

#------------------------------------------------------------------------------
# SMARTER_INFRASTRUCTURE_TASKS_CELERY_TASK_QUEUE -> smarter_settings.infrastructure_tasks_celery_task_queue
# The Celery queue of the infrastructure tasks, which deploy, verify and destroy
# cloud, Kubernetes and DNS resources, served by the smarter-worker-infrastructure
# worker. If you change it, also change that worker's -Q argument.
#------------------------------------------------------------------------------
# SMARTER_INFRASTRUCTURE_TASKS_CELERY_TASK_QUEUE="infrastructure_celery_task_queue"

#------------------------------------------------------------------------------
# SMARTER_VERBOSE_LOGGING -> smarter_settings.verbose_logging
# Includes additional debug information in the logs. Default: false.
#------------------------------------------------------------------------------
# SMARTER_VERBOSE_LOGGING=true

###############################################################################
# Unit tests
###############################################################################

#------------------------------------------------------------------------------
# SMARTER_MYSQL_TEST_DATABASE_SECRET_NAME and SMARTER_MYSQL_TEST_DATABASE_PASSWORD
#   -> smarter_settings.smarter_mysql_test_database_secret_name
#   -> smarter_settings.smarter_mysql_test_database_password
# The test database that the SqlPlugin tests use. The defaults match the user
# that scripts/smarter_test_db.sql creates in the local MariaDB.
#------------------------------------------------------------------------------
# SMARTER_MYSQL_TEST_DATABASE_SECRET_NAME=smarter_test_db
# SMARTER_MYSQL_TEST_DATABASE_PASSWORD=smarter_test_user

###############################################################################
# Helm chart testing: the Kubernetes secrets of smarter-platform-alpha.
# Not read by the platform.
###############################################################################
# SMARTER_NAMESPACE=smarter-platform-alpha
# SMARTER_MYSQL_HOST=SET-ME-PLEASE
# SMARTER_MYSQL_PORT=3306
# SMARTER_MYSQL_DATABASE=SET-ME-PLEASE
# SMARTER_MYSQL_PASSWORD=SET-ME-PLEASE
# SMARTER_MYSQL_USERNAME=SET-ME-PLEASE
# SMARTER_MYSQL_ROOT_USERNAME=SET-ME-PLEASE
# SMARTER_MYSQL_ROOT_PASSWORD=SET-ME-PLEASE
# SMARTER_LOGIN_URL=https://alpha.platform.example.com/login/
# SMARTER_ADMIN_PASSWORD=SET-ME-PLEASE
# SMARTER_ADMIN_USERNAME=admin
# SMARTER_DOCKER_IMAGE=012345678903.dkr.ecr.us-east-1.amazonaws.com/smarter-platform-alpha:latest
