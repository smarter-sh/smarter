    "beat": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["mysql", "mariadb", "external"] }
      }
    },
    "deployTimestamp": { "type": "string" },
    "deployment": {
      "type": "object",
      "properties": {
