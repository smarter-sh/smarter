{
  "name": "@smarter/workbench",
  "description": "The Prompt Engineer's Workbench of the Smarter web console: the chat with an LLMClient, from the @smarter.sh/ui-chat npm package, and the developer Console beside it.",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=dev && vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@microlink/react-json-view": "^1.31.40",
    "@smarter.sh/ui-chat": "*",
    "@smarter/common": "^0.2.0",
    "@smarter/llmclient-architecture": "^0.1.0",
    "@smarter/llmclient-deployment": "^0.1.0",
    "@smarter/manifest-editor": "^0.1.0",
    "katex": "^0.18.7",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
