{
  "name": "@smarter.sh/ui-widgets",
  "description": "Smarter web console dashboard widgets, for the web console and smarter.sh. They are styled for the Keen Bootstrap theme, which the page provides.",
  "version": "9999.9999.9999.dev9999",
  "homepage": "https://smarter.sh",
  "type": "module",
  "main": "./dist/ui-widgets.es.js",
  "module": "./dist/ui-widgets.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ui-widgets.es.js",
      "default": "./dist/ui-widgets.es.js"
    },
    "./style.css": "./dist/ui-widgets.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "./dist/ui-widgets.es.js"
  ],
  "keywords": [
    "react",
    "component",
    "dashboard",
    "smarter"
  ],
  "author": "Lawrence McDaniel <lpm0073@gmail.com>, (https://lawrencemcdaniel.com/)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarter-sh/smarter.git",
    "directory": "smarter/react/packages/smarter.sh-widgets"
  },
  "bugs": {
    "url": "https://github.com/smarter-sh/smarter/issues"
  },
  "scripts": {
    "build:lib": "vite build --mode lib && tsc -p tsconfig.lib.json",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@smarter/common": "^0.2.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
