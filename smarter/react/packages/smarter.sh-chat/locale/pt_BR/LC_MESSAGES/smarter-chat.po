#: src/lib/api.ts
msgid "Unexpected response from the Smarter api (http %(status)s): %(text)s"
msgstr "Resposta inesperada da api do Smarter (http %(status)s): %(text)s"

#: src/lib/api.ts
msgid "The Smarter api returned http %(status)s %(statusText)s"
msgstr "A api do Smarter retornou http %(status)s %(statusText)s"

#: src/lib/api.ts
msgid "The Smarter api returned an incomplete configuration."
msgstr "A api do Smarter retornou uma configuração incompleta."

#: src/lib/api.ts
msgid "The Smarter api returned an empty event stream."
msgstr "A api do Smarter retornou um fluxo de eventos vazio."

#: src/lib/api.ts
