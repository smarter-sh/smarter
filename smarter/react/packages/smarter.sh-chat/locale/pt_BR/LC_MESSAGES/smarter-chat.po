msgstr "O fluxo de eventos da api do Smarter terminou sem um resultado."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, %(reasoning)s of which it spent reasoning, so its response is incomplete."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, %(reasoning)s of which it spent reasoning, so its response is incomplete."
msgstr[0] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s token de completion, dos quais gastou %(reasoning)s raciocinando, por isso a resposta está incompleta."
msgstr[1] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s tokens de completion, dos quais gastou %(reasoning)s raciocinando, por isso a resposta está incompleta."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, %(reasoning)s of which it spent reasoning, so its response is empty."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, %(reasoning)s of which it spent reasoning, so its response is empty."
msgstr[0] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s token de completion, dos quais gastou %(reasoning)s raciocinando, por isso a resposta está vazia."
msgstr[1] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s tokens de completion, dos quais gastou %(reasoning)s raciocinando, por isso a resposta está vazia."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, so its response is incomplete."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, so its response is incomplete."
msgstr[0] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s token de completion, por isso a resposta está incompleta."
msgstr[1] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s tokens de completion, por isso a resposta está incompleta."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, so its response is empty."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, so its response is empty."
msgstr[0] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s token de completion, por isso a resposta está vazia."
msgstr[1] "O LLM atingiu o máximo de tokens deste LLMClient, %(tokens)s tokens de completion, por isso a resposta está vazia."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens, so its response is incomplete."
msgstr "O LLM atingiu o máximo de tokens deste LLMClient, por isso a resposta está incompleta."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens, so its response is empty."
msgstr "O LLM atingiu o máximo de tokens deste LLMClient, por isso a resposta está vazia."

#. Translators: defaultMaxTokens is a field of the LLMClient's manifest, which is not translated.
#: src/lib/api.ts
msgid "Raise defaultMaxTokens in the LLMClient's manifest."
msgstr "Aumente o defaultMaxTokens no manifesto do LLMClient."

