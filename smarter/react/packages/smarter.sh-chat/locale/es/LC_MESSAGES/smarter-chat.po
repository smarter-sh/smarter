msgstr "Algo salió mal."

#: src/components/SmarterChat/Component.tsx
msgid "Message"
msgstr "Mensaje"

#. Translators: the LLM provider and model of the chat, e.g. "openai gpt-4o-mini with 3 additional tools".
#: src/components/SmarterChat/Component.tsx
msgid "%(provider)s %(model)s with %(count)s additional tool"
msgid_plural "%(provider)s %(model)s with %(count)s additional tools"
msgstr[0] "%(provider)s %(model)s con %(count)s herramienta adicional"
