#. Translators: the default accessible name of the button that opens the chat, and of its panel.
#: src/components/SmarterChat/Component.tsx src/embed/EmbedApp.tsx
msgid "Chat"
msgstr "Chat"

#: src/components/SmarterChat/Component.tsx
msgid "Chat mode"
msgstr "Modo del chat"

#: src/components/SmarterChat/Component.tsx
msgid "Sandbox mode: Smarter's system, tool and meta data messages are displayed."
msgstr "Modo de pruebas: se muestran los mensajes de sistema, de herramientas y de metadatos de Smarter."

#. Translators: the sandbox mode option of the chat's mode switch.
#: src/components/SmarterChat/Component.tsx
msgctxt "chat mode"
msgid "Sandbox"
msgstr "Pruebas"

#: src/components/SmarterChat/Component.tsx
msgid "Production mode: the conversation is displayed as its users see it."
msgstr "Modo de producción: la conversación se muestra como la ven sus usuarios."

#. Translators: the production mode option of the chat's mode switch.
#: src/components/SmarterChat/Component.tsx
msgctxt "chat mode"
msgid "Production"
msgstr "Producción"

#: src/components/SmarterChat/Component.tsx
msgid "Start a new chat"
msgstr "Iniciar un chat nuevo"

#: src/components/SmarterChat/Component.tsx
msgid "Attach a file"
msgstr "Adjuntar un archivo"

#: src/embed/EmbedApp.tsx
msgid "Close %(label)s"
msgstr "Cerrar %(label)s"

#: src/lib/api.ts
msgid "Unexpected response from the Smarter api (http %(status)s): %(text)s"
msgstr "Respuesta inesperada de la api de Smarter (http %(status)s): %(text)s"

#: src/lib/api.ts
msgid "The Smarter api returned http %(status)s %(statusText)s"
msgstr "La api de Smarter devolvió http %(status)s %(statusText)s"

#: src/lib/api.ts
msgid "The Smarter api returned an incomplete configuration."
msgstr "La api de Smarter devolvió una configuración incompleta."

#: src/lib/api.ts
msgid "The Smarter api returned an empty event stream."
msgstr "La api de Smarter devolvió un flujo de eventos vacío."

#: src/lib/api.ts
msgid "The Smarter api's event stream ended without a result."
msgstr "El flujo de eventos de la api de Smarter terminó sin un resultado."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, %(reasoning)s of which it spent reasoning, so its response is incomplete."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, %(reasoning)s of which it spent reasoning, so its response is incomplete."
msgstr[0] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s token de completado, de los cuales usó %(reasoning)s para razonar, así que su respuesta está incompleta."
msgstr[1] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s tokens de completado, de los cuales usó %(reasoning)s para razonar, así que su respuesta está incompleta."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, %(reasoning)s of which it spent reasoning, so its response is empty."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, %(reasoning)s of which it spent reasoning, so its response is empty."
msgstr[0] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s token de completado, de los cuales usó %(reasoning)s para razonar, así que su respuesta está vacía."
msgstr[1] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s tokens de completado, de los cuales usó %(reasoning)s para razonar, así que su respuesta está vacía."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, so its response is incomplete."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, so its response is incomplete."
msgstr[0] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s token de completado, así que su respuesta está incompleta."
msgstr[1] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s tokens de completado, así que su respuesta está incompleta."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens of %(tokens)s completion token, so its response is empty."
msgid_plural "The LLM reached this LLMClient's max tokens of %(tokens)s completion tokens, so its response is empty."
msgstr[0] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s token de completado, así que su respuesta está vacía."
msgstr[1] "El LLM alcanzó el máximo de tokens de este LLMClient, %(tokens)s tokens de completado, así que su respuesta está vacía."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens, so its response is incomplete."
msgstr "El LLM alcanzó el máximo de tokens de este LLMClient, así que su respuesta está incompleta."

#: src/lib/api.ts
msgid "The LLM reached this LLMClient's max tokens, so its response is empty."
msgstr "El LLM alcanzó el máximo de tokens de este LLMClient, así que su respuesta está vacía."

#. Translators: defaultMaxTokens is a field of the LLMClient's manifest, which is not translated.
#: src/lib/api.ts
msgid "Raise defaultMaxTokens in the LLMClient's manifest."
msgstr "Aumenta defaultMaxTokens en el manifiesto del LLMClient."

