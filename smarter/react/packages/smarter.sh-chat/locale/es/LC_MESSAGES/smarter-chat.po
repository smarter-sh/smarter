msgid "Assistant"
msgstr "Asistente"

#: src/components/SmarterChat/Component.tsx
msgid "You"
msgstr "Tú"

#. Translators: the assistant's name, and the current step of the running prompt, which is in English.
#: src/components/SmarterChat/Component.tsx
msgid "%(assistant)s: %(step)s"
msgstr "%(assistant)s: %(step)s"

#: src/components/SmarterChat/Component.tsx
