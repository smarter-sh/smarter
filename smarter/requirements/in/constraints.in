#
# usage:      additional global version constraints.
#             -r constraints.in
#
# -----------------------------------------------------------------------------
social-auth-core<6                  # 6.x replaced AuthAlreadyAssociated, AuthTokenError, ... with a few exception classes and error codes. Port apps/account/pipeline.py and lib/social_core/backends/linkedin.py first
social-auth-app-django<7            # 7.x requires social-auth-core 6
langchain~=1.2.0                    # held at 1.2.x by the April 2026 version bumps (936a383fc), reason not recorded. 1.3 to 1.5 are out: run the prompt and vectorstore tests on one before loosening to ~=1.2
openai~=2.31                        # the 2.x SDK, imported directly by 14 modules, 7 of them in apps/provider. 3.x is out: a new major, so read its migration notes and port those modules first
mcp~=2.2                            # MCPClient was built on the 2.2 SDK, whose types are the separate mcp_types package. 3.x will need a port of apps/mcpclient/connection.py
nltk~=3.0                           # major-version cap only, from the March 2026 pin loosening (9b6b81f13)
