msgstr ""
"Échec de la suppression de la base vectorielle (%(status)s) : %(error)s"

#. Translators: used in react/packages/smarter-vectorstore-list/src/components/Toolbar/Component.tsx
msgid "Successfully deleted vectorstore"
msgstr "Base vectorielle supprimée"

#. Translators: used in react/packages/smarter-vectorstore-list/src/components/Toolbar/Component.tsx
msgid "Chat: Open the vectorstore workbench"
msgstr "Chat : ouvrir l'atelier de la base vectorielle"

#. Translators: used in react/packages/smarter-vectorstore-list/src/components/Toolbar/Component.tsx
msgid "Edit: Open the YAML manifest that defines this vectorstore resource"
msgstr ""
"Modifier : ouvrir le manifeste YAML qui définit cette ressource de base "
"vectorielle"

#. Translators: used in react/packages/smarter-vectorstore-list/src/components/Toolbar/Component.tsx
