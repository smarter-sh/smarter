msgstr "Échec du clonage de la base vectorielle (%(status)s) : %(error)s"

#. Translators: used in react/packages/smarter-vectorstore-list/src/components/Toolbar/Component.tsx
msgid "Successfully cloned vectorstore"
msgstr "Base vectorielle clonée"

#. Translators: used in react/packages/smarter-vectorstore-list/src/components/Toolbar/Component.tsx
