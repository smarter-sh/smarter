#: smarter/apps/account/activation.py
msgid "Activate your account."
msgstr "Activa tu cuenta."

#: smarter/apps/account/api/web/profile_image.py
msgid "Choose an image to upload."
msgstr "Elija una imagen para subir."

#: smarter/apps/account/api/web/profile_image.py
msgid "The image must be 2 MB or smaller."
msgstr "La imagen debe ocupar 2 MB o menos."

#: smarter/apps/account/api/web/profile_image.py
msgid "The image must be a PNG, JPEG, GIF or WebP file."
msgstr "La imagen debe ser un archivo PNG, JPEG, GIF o WebP."

#: smarter/apps/account/api/web/views.py
msgid "An unknown error occurred. Please try again later."
msgstr "Se produjo un error desconocido. Inténtalo de nuevo más tarde."

#: smarter/apps/account/api/web/views.py
msgid "Too many attempts. Try again in a minute."
msgstr "Demasiados intentos. Inténtalo de nuevo en un minuto."

#: smarter/apps/account/api/web/views.py
msgid "The request is invalid."
msgstr "La solicitud no es válida."

#: smarter/apps/account/api/web/views.py
msgid ""
"Your account isn't activated yet. Follow the link that we emailed you, or "
"ask for a new one."
msgstr ""
"Tu cuenta aún no está activada. Sigue el enlace que te enviamos por correo "
"electrónico o pide uno nuevo."

#: smarter/apps/account/api/web/views.py
msgid "Email and/or password do not match."
msgstr "El correo electrónico y/o la contraseña no coinciden."

#: smarter/apps/account/api/web/views.py
msgid "Registration is closed."
msgstr "El registro está cerrado."

#: smarter/apps/account/api/web/views.py
msgid "An account with this email address already exists. Please sign in."
msgstr ""
"Ya existe una cuenta con esta dirección de correo electrónico. Inicia sesión."

#: smarter/apps/account/api/web/views.py
msgid "Please correct the errors below."
msgstr "Corrige los errores que se indican a continuación."

#: smarter/apps/account/api/web/views.py
msgid ""
"We have emailed you a link to activate your account. Follow it to sign in."
msgstr ""
"Te enviamos por correo electrónico un enlace para activar tu cuenta. Síguelo "
"para iniciar sesión."

#: smarter/apps/account/api/web/views.py
msgid ""
"If an account with this email address is waiting to be activated, we have "
"sent it a new link."
msgstr ""
"Si hay una cuenta con esta dirección de correo electrónico pendiente de "
"activación, le enviamos un enlace nuevo."

#: smarter/apps/account/api/web/views.py
msgid ""
"If an account has this email address, we have sent it a link to reset the "
"password."
msgstr ""
"Si hay una cuenta con esta dirección de correo electrónico, le hemos enviado "
"un enlace para restablecer la contraseña."

#: smarter/apps/account/api/web/views.py
msgid "Choose a new password."
msgstr "Elige una contraseña nueva."

#: smarter/apps/account/api/web/views.py
msgid "Passwords do not match."
msgstr "Las contraseñas no coinciden."

#: smarter/apps/account/api/web/views.py
msgid "Your password has been changed. Sign in with it."
msgstr "Tu contraseña ha cambiado. Inicia sesión con ella."

#: smarter/apps/account/email_links.py
msgid "Invalid link. The user does not exist."
msgstr "Enlace no válido. El usuario no existe."

#: smarter/apps/account/management/commands/create_user.py
msgid "Your Smarter user account has been created"
msgstr "Se creó tu cuenta de usuario de Smarter"

#: smarter/apps/account/management/commands/create_user.py
#, python-format
msgid ""
"Your Smarter user account has been created. Do not share your account "
"credentials with anyone.\n"
"\n"
"Url: %(login_url)s\n"
"Username: %(username)s\n"
"Email: %(email)s\n"
"Password: %(password)s\n"
msgstr ""
"Se creó tu cuenta de usuario de Smarter. No compartas tus credenciales con "
"nadie.\n"
"\n"
"Url: %(login_url)s\n"
"Nombre de usuario: %(username)s\n"
"Correo electrónico: %(email)s\n"
"Contraseña: %(password)s\n"

#: smarter/apps/account/models/account_contact.py
msgid "Welcome to Smarter!"
msgstr "¡Te damos la bienvenida a Smarter!"

#: smarter/apps/account/models/account_contact.py
#: smarter/templates/account/email/slack-invitation.html
msgid "Join the Smarter community on Slack"
msgstr "Únete a la comunidad de Smarter en Slack"

#: smarter/apps/account/password_reset.py
msgid "Reset your password"
msgstr "Restablece tu contraseña"

#: smarter/apps/account/views/unsubscribe.py
msgid ""
"This unsubscribe link is not valid. Copy the whole link from the email, and "
"try again."
msgstr ""
"Este enlace para darte de baja no es válido. Copia el enlace completo del "
"correo e inténtalo de nuevo."

#: smarter/lib/social_core/backends/multitenant.py
msgid "Your subscription is not active. Please check your payment status."
msgstr "Tu suscripción no está activa. Revisa el estado de tu pago."

#: smarter/lib/tests/test_json.py
msgid "Name"
msgstr "Nombre"

#: smarter/templates/400.html
msgid "Bad Request"
msgstr "Solicitud incorrecta"

#: smarter/templates/400.html
msgid "Forbidden."
msgstr "Prohibido."

#: smarter/templates/400.html smarter/templates/403.html
#: smarter/templates/404.html smarter/templates/500.html
msgid "Return Home"
msgstr "Volver al inicio"

#: smarter/templates/403.html
msgid "Permission Denied"
msgstr "Permiso denegado"

#: smarter/templates/403.html
msgid "Permission Denied."
msgstr "Permiso denegado."

#: smarter/templates/404.html
msgid "Oops!"
msgstr "¡Ups!"

#: smarter/templates/404.html
msgid "The page you requested was not found."
msgstr "No se encontró la página que solicitaste."

#: smarter/templates/500.html
msgid "System Error"
msgstr "Error del sistema"

#: smarter/templates/500.html
msgid "A system error has occurred."
msgstr "Ocurrió un error del sistema."

#: smarter/templates/account/authentication/email/account-activation.html
msgid "Activate Your Account"
msgstr "Activa tu cuenta"

#: smarter/templates/account/authentication/email/account-activation.html
msgid ""
"Click on the link below or copy and paste it into your browser's address bar."
msgstr ""
"Haz clic en el siguiente enlace o cópialo y pégalo en la barra de "
"direcciones de tu navegador."

#: smarter/templates/account/authentication/email/account-activation.html
msgid "Thank you for using Smarter!"
msgstr "¡Gracias por usar Smarter!"

#: smarter/templates/account/authentication/email/account-activation.html
msgid "Activate Account"
msgstr "Activar cuenta"

#: smarter/templates/account/authentication/email/account-activation.html
msgid "If you require assistance"
msgstr "Si necesitas ayuda"

#: smarter/templates/account/authentication/email/account-activation.html
#: smarter/templates/account/authentication/email/password-reset.html
#, python-format
msgid "Call our customer care number: %(phone)s"
msgstr "Llama a nuestro número de atención al cliente: %(phone)s"

#: smarter/templates/account/authentication/email/account-activation.html
#: smarter/templates/account/authentication/email/password-reset.html
#, python-format
msgid "Email: %(email)s"
msgstr "Correo: %(email)s"

#: smarter/templates/account/authentication/email/account-activation.html
#: smarter/templates/account/authentication/email/password-reset.html
msgid "Contact:"
msgstr "Contacto:"

#: smarter/templates/account/authentication/email/account-activation.html
#: smarter/templates/account/authentication/email/password-reset.html
#, python-format
msgid "Office Hours: %(hours)s"
msgstr "Horario de atención: %(hours)s"

#: smarter/templates/account/authentication/email/password-reset.html
msgid "Smarter Logo"
msgstr "Logotipo de Smarter"

#: smarter/templates/account/authentication/email/password-reset.html
msgid "Reset Your Password"
msgstr "Restablece tu contraseña"

#: smarter/templates/account/authentication/email/password-reset.html
msgid ""
"We received a request to reset your password. If you didn't make the "
"request, just ignore this email. Otherwise, you can reset your password "
"using the link below."
msgstr ""
"Recibimos una solicitud para restablecer tu contraseña. Si no la hiciste, "
"simplemente ignora este correo. De lo contrario, puedes restablecer tu "
"contraseña con el siguiente enlace."

#: smarter/templates/account/authentication/email/password-reset.html
msgid "This link will expire in 24 hours, so be sure to use it right away."
msgstr "Este enlace vence en 24 horas, así que úsalo de inmediato."

#: smarter/templates/account/authentication/email/password-reset.html
#, python-format
msgid "Thank you for being part of %(product_name)s!"
msgstr "¡Gracias por ser parte de %(product_name)s!"

#: smarter/templates/account/authentication/email/password-reset.html
msgid "Reset Password"
msgstr "Restablecer contraseña"

#: smarter/templates/account/authentication/email/password-reset.html
msgid "Or, talk to a human!"
msgstr "¡O habla con una persona!"

#: smarter/templates/account/email/slack-invitation.html
msgid "The Smarter Project on Slack"
msgstr "The Smarter Project en Slack"

#: smarter/templates/account/email/slack-invitation.html
msgid ""
"Where the people who build, run and learn Smarter meet, and where the "
"platform reports on its own health, every day, in public."
msgstr ""
"Donde se reúnen las personas que construyen, operan y aprenden Smarter, y "
"donde la plataforma informa de su propio estado, cada día, en público."

#: smarter/templates/account/email/slack-invitation.html
#: smarter/templates/account/email/welcome.html
#, python-format
msgid "Howdy %(first_name)s,"
msgstr "Hola, %(first_name)s:"

#: smarter/templates/account/email/slack-invitation.html
#: smarter/templates/account/email/welcome.html
msgid "Howdy,"
msgstr "Hola:"

#: smarter/templates/account/email/slack-invitation.html
#, python-format
msgid ""
"A couple of days ago you received your welcome to %(product_name)s. Now that "
"you've had a chance to look around, I'd like to invite you to The Smarter "
"Project's Slack workspace. It's free and open to everyone, and it's the "
"fastest way to get answers, to see what's changing, and to meet the people "
"behind the platform."
msgstr ""
"Hace un par de días recibiste tu bienvenida a %(product_name)s. Ahora que "
"has tenido ocasión de echar un vistazo, me gustaría invitarte al espacio de "
"trabajo de Slack de The Smarter Project. Es gratuito y está abierto a todo "
"el mundo, y es la forma más rápida de obtener respuestas, ver qué está "
"cambiando y conocer a las personas que hay detrás de la plataforma."

#: smarter/templates/account/email/slack-invitation.html
msgid "Join the Smarter Slack"
msgstr "Únete al Slack de Smarter"

#: smarter/templates/account/email/slack-invitation.html
msgid "The project's pulse, in public"
msgstr "El pulso del proyecto, en público"

#: smarter/templates/account/email/slack-invitation.html
#, python-format
msgid ""
"%(product_name)s is open source, and so is the way it's run. Automated "
"workflows post their results to Slack around the clock: test runs across "
"every repository, deployments, security and secrets reviews, dependency "
"updates, and a daily review of the production platform's logs. You see the "
"health of the platform as it happens, not after the fact."
msgstr ""
"%(product_name)s es de código abierto, y también lo es la forma en que se "
"gestiona. Flujos de trabajo automatizados publican sus resultados en Slack a "
"todas horas: pruebas en todos los repositorios, despliegues, revisiones de "
"seguridad y de secretos, actualizaciones de dependencias y una revisión "
"diaria de los registros de la plataforma de producción. Ves el estado de la "
"plataforma en el momento, no a posteriori."

#: smarter/templates/account/email/slack-invitation.html
msgid "Channels worth following"
msgstr "Canales que vale la pena seguir"

#: smarter/templates/account/email/slack-invitation.html
msgid "Join the ones you care about, and mute the rest."
msgstr "Únete a los que te interesen y silencia el resto."

#: smarter/templates/account/email/slack-invitation.html
msgid "Chat directly with the @Smarter Developer agent, any time of day."
msgstr ""
"Conversa directamente con el agente @Smarter Developer, a cualquier hora del "
"día."

#: smarter/templates/account/email/slack-invitation.html
msgid ""
"Every new post on blog.smarter.sh: release announcements, how-tos, and the "
"stories behind the code."
msgstr ""
"Cada nueva publicación de blog.smarter.sh: anuncios de versiones, guías "
"prácticas y las historias detrás del código."

#: smarter/templates/account/email/slack-invitation.html
msgid ""
"New releases of every smarter-sh repository: the platform, the command-line "
"interface, the SDKs and more."
msgstr ""
"Las nuevas versiones de todos los repositorios de smarter-sh: la plataforma, "
"la interfaz de línea de comandos, los SDK y más."

#: smarter/templates/account/email/slack-invitation.html
msgid ""
"Workflow results of the Smarter platform itself, including the daily review "
"of the production platform's logs."
msgstr ""
"Los resultados de los flujos de trabajo de la propia plataforma Smarter, "
"incluida la revisión diaria de los registros de la plataforma de producción."

#: smarter/templates/account/email/slack-invitation.html
msgid "Pull requests, issues and CI runs from GitHub, as they happen."
msgstr ""
"Pull requests, issues y ejecuciones de CI de GitHub, en el momento en que "
"ocurren."

#: smarter/templates/account/email/slack-invitation.html
msgid ""
"Conversation, plus the reports of the project's other repositories: security "
"reviews, dependency updates, package health, and a daily Did You Know? tip."
msgstr ""
"Conversación, además de los informes de los demás repositorios del proyecto: "
"revisiones de seguridad, actualizaciones de dependencias, estado de los "
"paquetes y un consejo diario «¿Sabías que…?»."

#: smarter/templates/account/email/slack-invitation.html
msgid ""
"A private channel for the people who contribute to Smarter. Contributions of "
"every size are welcome."
msgstr ""
"Un canal privado para las personas que contribuyen a Smarter. Las "
"contribuciones de cualquier tamaño son bienvenidas."

#: smarter/templates/account/email/slack-invitation.html
msgid "Ask @Smarter Developer anything"
msgstr "Pregúntale lo que quieras a @Smarter Developer"

#: smarter/templates/account/email/slack-invitation.html
#, python-format
msgid ""
"The workspace has its own AI agent, which answers questions about "
"%(product_name)s at any hour. It searches and reads the source code and "
"documentation of every smarter-sh repository before it answers, and links to "
"what it used. Ask it in #help, in a direct message, or by mentioning it in "
"any channel."
msgstr ""
"El espacio de trabajo tiene su propio agente de IA, que responde preguntas "
"sobre %(product_name)s a cualquier hora. Antes de responder, busca y lee el "
"código fuente y la documentación de todos los repositorios de smarter-sh, y "
"enlaza lo que utilizó. Pregúntale en #help, en un mensaje directo o "
"mencionándolo en cualquier canal."

#: smarter/templates/account/email/slack-invitation.html
msgid "Try asking"
msgstr "Prueba a preguntar"

#: smarter/templates/account/email/slack-invitation.html
msgid "How do I add a Smarter chatbot to my WordPress site?"
msgstr "¿Cómo añado un chatbot de Smarter a mi sitio de WordPress?"

#: smarter/templates/account/email/slack-invitation.html
msgid "Write an MCPClient manifest for an MCP server that needs an API key."
msgstr ""
"Escribe un manifiesto de MCPClient para un servidor MCP que necesita una "
"clave de API."

#: smarter/templates/account/email/slack-invitation.html
msgid "What changed in the last release of the command-line interface?"
msgstr "¿Qué cambió en la última versión de la interfaz de línea de comandos?"

#: smarter/templates/account/email/slack-invitation.html
msgid "A direct message with @Smarter Developer in Slack"
msgstr "Un mensaje directo con @Smarter Developer en Slack"

#: smarter/templates/account/email/slack-invitation.html
msgid "How to get the best answers from the bot"
msgstr "Cómo obtener las mejores respuestas del bot"

#: smarter/templates/account/email/slack-invitation.html
msgid "See you in Slack!"
msgstr "¡Nos vemos en Slack!"

#: smarter/templates/account/email/slack-invitation.html
#, python-format
msgid ""
"Or copy this link into your browser: <a href=\"%(slack_url)s\" "
"rel=\"noopener\" target=\"_blank\" style=\"color:#7E8299\">%(slack_url)s</a>"
msgstr ""
"O copia este enlace en tu navegador: <a href=\"%(slack_url)s\" "
"rel=\"noopener\" target=\"_blank\" style=\"color:#7E8299\">%(slack_url)s</a>"

#: smarter/templates/account/email/slack-invitation.html
#: smarter/templates/account/email/welcome.html
#, python-format
msgid "Technical point of contact for %(product_name)s."
msgstr "Contacto técnico de %(product_name)s."

#: smarter/templates/account/email/slack-invitation.html
#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"Email me at <a href=\"mailto:%(support_email)s\" style=\"font-weight: "
"600\">%(support_email)s</a>, or visit <a href=\"%(contact_url)s\" "
"rel=\"noopener\" target=\"_blank\" style=\"font-weight: 600\">my website</a>."
msgstr ""
"Escríbeme a <a href=\"mailto:%(support_email)s\" style=\"font-weight: "
"600\">%(support_email)s</a>, o visita <a href=\"%(contact_url)s\" "
"rel=\"noopener\" target=\"_blank\" style=\"font-weight: 600\">mi sitio web</"
"a>."

#: smarter/templates/account/email/slack-invitation.html
#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"%(product_name)s is free, open source software, licensed under the <a "
"href=\"https://www.gnu.org/licenses/agpl-3.0.html\" rel=\"noopener\" "
"target=\"_blank\">GNU AGPL v3</a>."
msgstr ""
"%(product_name)s es software libre y de código abierto, con licencia <a "
"href=\"https://www.gnu.org/licenses/agpl-3.0.html\" rel=\"noopener\" "
"target=\"_blank\">GNU AGPL v3</a>."

#: smarter/templates/account/email/unsubscribe-footer.html
msgid ""
"You received this email because you have a Smarter account, or were invited "
"to Smarter."
msgstr ""
"Recibiste este correo porque tienes una cuenta de Smarter, o te invitaron a "
"Smarter."

#: smarter/templates/account/email/unsubscribe-footer.html
msgid "Unsubscribe from these emails"
msgstr "Darte de baja de estos correos"

#: smarter/templates/account/email/welcome.html
#, python-format
msgid "Welcome to %(product_name)s!"
msgstr "¡Te damos la bienvenida a %(product_name)s!"

#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"I'm %(primary_contact)s, the technical point of contact for "
"%(product_name)s, and I just created a new account for you. To get started, "
"sign in with the button below. Your username is this email address."
msgstr ""
"Soy %(primary_contact)s, el contacto técnico de %(product_name)s, y acabo de "
"crearte una cuenta nueva. Para empezar, inicia sesión con el botón de abajo. "
"Tu nombre de usuario es esta dirección de correo electrónico."

#: smarter/templates/account/email/welcome.html
msgid "You should receive your password in a separate text-only email."
msgstr "Recibirás tu contraseña en otro correo electrónico, de solo texto."

#: smarter/templates/account/email/welcome.html
msgid ""
"You can use the 'Forgot Password' link on the sign-in page to change your "
"password at any time."
msgstr ""
"Puedes usar el enlace «¿Olvidaste tu contraseña?» de la página de inicio de "
"sesión para cambiar tu contraseña cuando quieras."

#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"If you have any questions, email me at <a href=\"mailto:%(support_email)s\" "
"style=\"font-weight:600\">%(support_email)s</a>."
msgstr ""
"Si tienes alguna pregunta, escríbeme a <a href=\"mailto:%(support_email)s\" "
"style=\"font-weight:600\">%(support_email)s</a>."

#: smarter/templates/account/email/welcome.html
msgid "Sign In"
msgstr "Iniciar sesión"

#: smarter/templates/account/email/welcome.html
msgid "What's included:"
msgstr "Qué incluye:"

#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"<strong>An account on %(product_name)s <a href=\"%(login_url)s\" "
"target=\"_blank\" rel=\"noopener\">platform</a></strong> for the duration of "
"this course. Every prompt is a real, billable request to an LLM provider, so "
"please experiment freely, but don't run automated load against it."
msgstr ""
"<strong>Una cuenta en la <a href=\"%(login_url)s\" target=\"_blank\" "
"rel=\"noopener\">plataforma</a> %(product_name)s</strong> durante este "
"curso. Cada prompt es una solicitud real, facturable, a un proveedor de LLM, "
"así que experimenta con libertad, pero no le envíes carga automatizada."

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>Your own AI resources.</strong> You can create, change and delete "
"your own LLMClients, plugins, connections and secrets, and you are "
"encouraged to experiment with them while you are attending this course."
msgstr ""
"<strong>Tus propios recursos de IA.</strong> Puedes crear, cambiar y "
"eliminar tus propios LLMClients, plugins, conexiones y secretos, y te "
"animamos a experimentar con ellos mientras asistes a este curso."

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>Thousands of LLMs from nine providers:</strong> Anthropic, Cohere, "
"Fireworks AI, Google AI (Gemini), Hugging Face, Meta AI (Llama), Mistral, "
"OpenAI and Together AI, all through a single interface, so that you can "
"compare models hands-on."
msgstr ""
"<strong>Miles de LLM de nueve proveedores:</strong> Anthropic, Cohere, "
"Fireworks AI, Google AI (Gemini), Hugging Face, Meta AI (Llama), Mistral, "
"OpenAI y Together AI, todos a través de una única interfaz, para que puedas "
"comparar modelos en la práctica."

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong><a href=\"https://docs.smarter.sh/smarter-resources/smarter-"
"llmtool.html\" rel=\"noopener\" target=\"_blank\">Plugins</a> for LLM tool "
"calling</strong> that connect an LLM to SQL databases, remote REST APIs, web "
"search, image search, Agent Skills and static data. Your data stays where it "
"is: the LLM only sees the query results and responses that it asks for. <a "
"href=\"https://docs.smarter.sh/smarter-framework/smarter-extensions.html\" "
"rel=\"noopener\" target=\"_blank\">Extensions</a>, which the platform "
"administrator installs, add tools written in Python."
msgstr ""
"<strong><a href=\"https://docs.smarter.sh/smarter-resources/smarter-"
"llmtool.html\" rel=\"noopener\" target=\"_blank\">Plugins</a> para la "
"llamada a herramientas de los LLM</strong>, que conectan un LLM con bases de "
"datos SQL, APIs REST remotas, búsqueda web, búsqueda de imágenes, Agent "
"Skills y datos estáticos. Tus datos se quedan donde están: el LLM solo ve "
"los resultados de las consultas y las respuestas que pide. Las <a "
"href=\"https://docs.smarter.sh/smarter-framework/smarter-extensions.html\" "
"rel=\"noopener\" target=\"_blank\">extensiones</a>, que instala el "
"administrador de la plataforma, añaden herramientas escritas en Python."

#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"<strong>A no-code approach to authoring AI resources.</strong> Every "
"resource in %(product_name)s is a short <a href=\"https://docs.smarter.sh/"
"smarter-framework/smarter-manifests.html\" rel=\"noopener\" "
"target=\"_blank\">YAML manifest</a>, so you can build and manage a working "
"AI application without writing code."
msgstr ""
"<strong>Un enfoque sin código para crear recursos de IA.</strong> Cada "
"recurso de %(product_name)s es un breve <a href=\"https://docs.smarter.sh/"
"smarter-framework/smarter-manifests.html\" rel=\"noopener\" "
"target=\"_blank\">manifiesto YAML</a>, así que puedes crear y gestionar una "
"aplicación de IA funcional sin escribir código."

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>A web Prompt Engineering Workbench</strong> for designing, testing "
"and debugging the prompts of your AI applications interactively."
msgstr ""
"<strong>Un Prompt Engineering Workbench web</strong> para diseñar, probar y "
"depurar de forma interactiva los prompts de tus aplicaciones de IA."

#: smarter/templates/account/email/welcome.html
msgid "Open Source, Built for Production"
msgstr "Código abierto, hecho para producción"

#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"<strong>%(product_name)s is more than a teaching tool.</strong> It is free, "
"open source software, licensed under the GNU AGPL v3, and it was built to "
"run in production: on Kubernetes, with cost accounting, secrets management "
"and per-account access control. Running at scale, security and cost "
"management may be out of scope for this course, but you will face them once "
"you complete it, and the source code and documentation are there for you to "
"explore, during the course and after."
msgstr ""
"<strong>%(product_name)s es más que una herramienta de enseñanza.</strong> "
"Es software libre y de código abierto, con licencia GNU AGPL v3, y se creó "
"para funcionar en producción: en Kubernetes, con contabilidad de costos, "
"gestión de secretos y control de acceso por cuenta. Funcionar a escala, la "
"seguridad y la gestión de costos pueden quedar fuera del alcance de este "
"curso, pero te enfrentarás a ellos cuando lo termines, y el código fuente y "
"la documentación están ahí para que los explores, durante el curso y después."

#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"Some links to help you get started on your journey to mastering "
"%(product_name)s:"
msgstr ""
"Algunos enlaces para ayudarte a empezar tu camino hacia el dominio de "
"%(product_name)s:"

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>Online documentation</strong> - <a href=\"https://docs.smarter.sh/\" "
"rel=\"noopener\" target=\"_blank\">https://docs.smarter.sh/</a>"
msgstr ""
"<strong>Documentación en línea</strong> - <a href=\"https://docs.smarter.sh/"
"\" rel=\"noopener\" target=\"_blank\">https://docs.smarter.sh/</a>"

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>Cost accounting</strong> of every LLM request, by account, user and "
"chat session <a href=\"https://docs.smarter.sh/smarter-platform/cost-"
"accounting.html\" rel=\"noopener\" target=\"_blank\">[learn more]</a>"
msgstr ""
"<strong>Contabilidad de costos</strong> de cada solicitud a un LLM, por "
"cuenta, usuario y sesión de chat <a href=\"https://docs.smarter.sh/smarter-"
"platform/cost-accounting.html\" rel=\"noopener\" target=\"_blank\">[más "
"información]</a>"

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>Runs on Kubernetes</strong>, on-premise or in the cloud <a "
"href=\"https://docs.smarter.sh/smarter-framework/technologies/"
"kubernetes.html\" rel=\"noopener\" target=\"_blank\">[learn more]</a>"
msgstr ""
"<strong>Funciona en Kubernetes</strong>, en tus propias instalaciones o en "
"la nube <a href=\"https://docs.smarter.sh/smarter-framework/technologies/"
"kubernetes.html\" rel=\"noopener\" target=\"_blank\">[más información]</a>"

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>Developer tools</strong>: a command-line interface, a REST API, and "
"SDKs for Python, Node.js and Go <a href=\"https://docs.smarter.sh/smarter-"
"framework/apis-and-sdks.html\" rel=\"noopener\" target=\"_blank\">[learn "
"more]</a>"
msgstr ""
"<strong>Herramientas para desarrolladores</strong>: una interfaz de línea de "
"comandos, una API REST y SDKs para Python, Node.js y Go <a href=\"https://"
"docs.smarter.sh/smarter-framework/apis-and-sdks.html\" rel=\"noopener\" "
"target=\"_blank\">[más información]</a>"

#: smarter/templates/account/email/welcome.html
#, python-format
msgid ""
"<strong>Slack</strong> - join The Smarter Project's Slack workspace for real-"
"time questions and discussion with other users and contributors <a "
"href=\"%(slack_url)s\" rel=\"noopener\" target=\"_blank\">[join]</a>"
msgstr ""
"<strong>Slack</strong> - únete al espacio de trabajo de Slack de The Smarter "
"Project para hacer preguntas y conversar en tiempo real con otros usuarios y "
"colaboradores <a href=\"%(slack_url)s\" rel=\"noopener\" "
"target=\"_blank\">[unirse]</a>"

#: smarter/templates/account/email/welcome.html
msgid ""
"<strong>Source code</strong> on GitHub, where contributions are welcome <a "
"href=\"https://github.com/smarter-sh/\" rel=\"noopener\" "
"target=\"_blank\">[learn more]</a>"
