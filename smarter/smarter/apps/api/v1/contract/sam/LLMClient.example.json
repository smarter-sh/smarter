{
  "apiVersion": "smarter.sh/v1",
  "kind": "LLMClient",
  "metadata": {
    "annotations": [
      {
        "color": "red"
      },
      {
        "size": "medium"
      },
      {
        "hash": "sha256:abc123def456"
      }
    ],
    "description": "This is an example llmclient manifest generated by the SAMLLMClientBroker. It serves as a template for creating your own llmclient manifests.",
    "name": "example_llmclient",
    "tags": [
      "example",
      "template",
      "school-project"
    ],
    "version": "1.0.0"
  },
  "spec": {
    "apiKey": "snake_case_api_key_name",
    "config": {
      "prompt": {
        "allowedOrigins": [],
        "appAssistant": "Example Assistant",
        "appExamplePrompts": [
          "What is the weather like today?",
          "Can you tell me a joke?",
          "How do I reset my password?"
        ],
        "appFileAttachment": false,
        "appInfoUrl": "https://example.com/info",
        "appName": "Example LLMClient",
        "appPlaceholder": "Type your message here...",
        "appWelcomeMessage": "Welcome to the Example LLMClient! How can I assist you today?",
        "customDomain": null,
        "defaultMaxTokens": 2048,
        "defaultModel": "gpt-6-luna",
        "defaultSystemRole": "You are a helpful llmclient. When given the opportunity to utilize function calling, you should always do so. This will allow you to provide the best possible responses to the user. If you are unable to provide a response, you should prompt the user for more information. If you are still unable to provide a response, you should inform the user that you are unable to help them at this time.",
        "defaultTemperature": 1.0,
        "deployed": false,
        "provider": "openai",
        "subdomain": null
      },
      "styles": {
        "appBackgroundImageSize": "cover",
        "appBackgroundImageUrl": "https://cdn.smarter.sh/prompt-ui/background.png",
        "appLogoUrl": "https://cdn.smarter.sh/images/logo/smarter-crop.png",
        "assistantAvatarUrl": null,
        "borderRadius": "14px",
        "buttons": null,
        "conversationHeader": {
          "backgroundColor": "#1b1f3b",
          "borderColor": null,
          "color": "#ffffff",
          "infoColor": "#c0c4e0"
        },
        "fontFamily": null,
        "fontSize": null,
        "googleFont": "Inter",
        "incomingMessage": {
          "backgroundColor": "#eef1ff",
          "borderColor": null,
          "color": "#1b1f3b",
          "linkColor": null
        },
        "mainContainer": null,
        "messageInput": null,
        "messageList": null,
        "outgoingMessage": {
          "backgroundColor": "#ff5733",
          "borderColor": null,
          "color": "#ffffff",
          "linkColor": null
        },
        "typingIndicator": null,
        "userAvatarUrl": null
      }
    },
    "extensions": [
      "calculator",
      "date-calculator",
      "weather"
    ],
    "guardrails": [
      "pii_redaction_input",
      "prompt_injection_keyword_input",
      "moderation_output"
    ],
    "mcpClients": [
      "deepwiki"
    ],
    "plugins": [
      "everlasting_gobstopper",
      "example_configuration",
      "bw_image_search",
      "diagram_image_search",
      "safe_image_search",
      "svg_image_search",
      "image_search",
      "anthropic_internal_comms",
      "anthropic_mcp_builder",
      "anthropic_pdf",
      "brand_voice_support_replies",
      "code_review",
      "meeting_notes",
      "sql_analyst",
      "python_docs_assistant",
      "local_search_fr",
      "market_research",
      "news_monitor",
      "research_assistant",
      "url_reader"
    ]
  }
