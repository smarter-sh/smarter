{
  "apiVersion": "smarter.sh/v1",
  "kind": "Orchestrator",
  "metadata": {
    "annotations": [
      {
        "pattern": "supervisor-worker"
      }
    ],
    "description": "This is an example orchestrator manifest generated by the SAMOrchestratorBroker. It serves as a template for creating your own orchestrator manifests.",
    "name": "example_orchestrator",
    "tags": [
      "example",
      "template",
      "agentic"
    ],
    "version": "1.0.0"
  },
  "spec": {
    "config": {
      "harnesses": [
        {
          "config": {
            "temperature": 0.2
          },
          "executionOrder": 0,
          "isActive": true,
          "llmClientName": "example-planner-client",
          "role": "planner"
        },
        {
          "config": {
            "temperature": 0.7
          },
          "executionOrder": 1,
          "isActive": true,
          "llmClientName": "example-executor-client",
          "role": "executor"
        }
      ],
      "isActive": true,
      "maxIterations": 10,
      "strategy": "supervisor"
    }
  }
}
