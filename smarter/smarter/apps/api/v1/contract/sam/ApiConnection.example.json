{
  "apiVersion": "smarter.sh/v1",
  "kind": "ApiConnection",
  "metadata": {
    "annotations": [
      {
        "smarter.sh/connection": "example_connection"
      },
      {
        "smarter.sh/created_by": "smarter_api_connection_broker"
      }
    ],
    "description": "Example ApiConnection using any of the following authentication methods: ['none', 'basic', 'token', 'oauth']",
    "name": "example_connection",
    "tags": [
      "example",
      "api",
      "connection"
    ],
    "version": "0.1.0"
  },
  "spec": {
    "connection": {
      "apiKey": "12345-top-secret-67890-fghij",
      "authMethod": "token",
      "baseUrl": "http://localhost:9357/",
      "proxyHost": "proxy.example.com",
      "proxyPassword": "proxypass",
      "proxyPort": 8080,
      "proxyProtocol": "http",
      "proxyUsername": "proxyuser",
      "timeout": 30
    }
  }
}
