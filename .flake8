[flake8]
# pyflakes (F: unused and undefined names, ...) and pycodestyle (E, W). An explicit select also
# keeps any other installed plugin's codes out, and turns on the checks in flake8's default
# ignore list, so the ones that disagree with black are listed below.
select = E,W,F
# Black formats the code, so these pycodestyle checks, which disagree with its output, are off:
#   E203  whitespace before ':', which black writes in slices such as items[a + 1 :]
#   E501  line too long: black owns line length (120, in pyproject.toml), and leaves long
#         strings and comments as they are rather than break them
#   E701  a statement on the same line as a colon, which black writes for stubs (class X: ...)
#   E704  a def on one line, which black writes for stubs (def f(self) -> int: ...)
#   W503  a line break before a binary operator, which is where black breaks
extend-ignore = E203,E501,E701,E704,W503
max-line-length = 120
# mccabe's cyclomatic complexity limit (C901). The repository has a backlog of functions above it,
# so C901 is not selected here: the complexity-new-violations hook runs flake8 with
# --select=C901 and this limit, and fails only on a function that a change makes too complex.
# See scripts/complexity_new_violations.py. To list the backlog: flake8 --select=C901 smarter
max-complexity = 10
# Migrations are generated by Django's makemigrations, and released ones are never edited, so
# they are not linted. __version__.py is written by the release workflow.
extend-exclude = venv,node_modules,*/migrations/*,__version__.py
per-file-ignores =
    # The environments' settings modules extend the shared ones with a star import, by design.
    smarter/smarter/settings/alpha.py: F403,F405
    smarter/smarter/settings/base_aws.py: F403,F405
    smarter/smarter/settings/beta.py: F403,F405
    smarter/smarter/settings/local.py: F403,F405
    smarter/smarter/settings/next.py: F403,F405
    smarter/smarter/settings/prod.py: F403,F405
    # Sphinx's configuration must put the package on sys.path, and set up Django, before it
    # imports the package and the extensions that read its models.
    docs/source/conf.py: E402
